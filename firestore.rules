rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && groupId is string
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    // Transações pessoais (uid == auth.uid) e compartilhadas (groupId de um grupo em que é membro)
    match /transactions/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && (!('groupId' in request.resource.data)
            || request.resource.data.groupId == null
            || isGroupMember(request.resource.data.groupId));

      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid
            || ('groupId' in resource.data && isGroupMember(resource.data.groupId)));

      // update não pode reatribuir o doc a outro uid
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // Estado dos módulos (limites, assinaturas, contas, estoque, categorias, metas, activeGroupId): 1 doc por usuário
    match /modules/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Grupos e carteiras compartilhadas (Modo Família)
    match /groups/{groupId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;

      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.memberUids || groupId == request.auth.uid);

      // Membro pode atualizar carteiras/membros; novo membro pode entrar via convite
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.memberUids
            || request.auth.uid in request.resource.data.memberUids);

      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Códigos de convite do Modo Família (ex.: FAM-7K3M)
    match /invites/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isGroupMember(request.resource.data.groupId);
      allow delete: if isSignedIn()
        && (resource.data.createdBy == request.auth.uid
            || isGroupMember(resource.data.groupId));
    }

    // Feedback (mantido do projeto original)
    match /feedback/{docId} {
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.type in ['bug', 'suggestion']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if false;
    }
  }
}
